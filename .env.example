# Beispiel-Umgebungskonfiguration für swiss-environment-mcp.
# Kopieren nach `.env` und Werte anpassen. `.env` ist via .gitignore ausgeschlossen.
#
# Hinweis: Dieser Server nutzt ausschliesslich öffentliche BAFU-Daten und
# benötigt KEINE Secrets / API-Keys (siehe docs/security.md, Audit SEC-013).
# Die folgenden Variablen steuern nur Transport und Netzwerk-Binding.

# Transport: "stdio" (lokal, Default) oder "streamable-http" (Cloud/HTTP)
MCP_TRANSPORT=stdio

# Host-Binding. Default 127.0.0.1 (sicher, lokal). Im Container/Cloud auf
# 0.0.0.0 setzen, damit der Dienst erreichbar ist (Audit SEC-016).
MCP_HOST=127.0.0.1

# Port für den HTTP-Transport
PORT=8000
